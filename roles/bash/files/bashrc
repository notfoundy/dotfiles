# .bashrc
# shellcheck shell=bash

# Don't put duplicate lines in the history. See bash(1) for more options
export HISTCONTROL=ignoredups

# Source files
while IFS= read -r -d '' file; do
  # shellcheck source=/dev/null
  source "$file"
done < <(find "$HOME/.config/bash/" -type f -name "*.sh" -print0)

PATHS=(
  "$HOME/.local/go/bin"
  "$HOME/.local/node/bin"
  "$HOME/go/bin"
  "$HOME/.local/bin"
  "$HOME/.dotfiles/bin"
)

# PATH
for p in "${PATHS[@]}"; do
  if [[ -d "$p" && ":$PATH:" != *":$p:"* ]]; then
    export PATH="$PATH:$p"
  fi
done

# Starship
eval "$(starship init bash)"

# FZF
eval "$(fzf --bash)"

# Zoxide
eval "$(zoxide init bash)"
