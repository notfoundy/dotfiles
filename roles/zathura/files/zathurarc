# Colours, generated by Noctalia from the current palette
include noctalia

set font "Inter 11"
set selection-clipboard clipboard
set window-title-basename true
set statusbar-home-tilde true

# Pages take the theme's colours, images keep their own (CTRL + R toggles it)
set recolor true
set recolor-keephue true
set recolor-reverse-video true

set adjust-open "width"
set page-v-padding 8
set page-h-padding 8
set scroll-page-aware true
set scroll-step 80
