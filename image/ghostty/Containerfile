ARG FEDORA_VERSION=44

FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION} AS build
RUN dnf -y install gtk4-devel gtk4-layer-shell-devel libadwaita-devel gettext
COPY scripts/ghostty.sh scripts/runtime-deps.sh /ctx/

# renovate: datasource=github-tags depName=ghostty-org/ghostty extractVersion=^v(?<version>\d+\.\d+\.\d+)$
ARG GHOSTTY_VERSION=1.3.1
RUN bash /ctx/ghostty.sh && bash /ctx/runtime-deps.sh

FROM scratch
COPY --from=build /out /out
COPY --from=build /deps /deps
